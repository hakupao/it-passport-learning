// D-217 H3 — local only: `wrangler dev` of the real Worker (worker/index.ts) in workerd, with a one-file
// assets dir (wrangler dev cannot watch the 16k-file out/ on this machine, see scripts/local-cf.ts,
// which serves out/ and proxies /api/* here). Same compatibility settings as ../../wrangler.jsonc.
// Env comes from worker/local/.dev.vars (gitignored; fake values only — see
// evidence/phase5/hosting/H3_worker.md §6). This directory has no .env*: wrangler would load
// apps/web/.env.local (Upstash credentials; the DB was deleted 2026-11-12, D-228, but any new DB's values
// would live there too) if run from apps/web with a .dev.vars-less config.
{
  "name": "itlearn-local",
  "main": "../index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}

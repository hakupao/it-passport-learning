{
  "unit_id": "technology-23-61-u12",
  "patches": [
    {
      "id": "p01",
      "status": "active",
      "base_sha256": "95a33041b002fe6f2a3e7667e87d077c1955bc6cd550b6ce263536b27fcc2ec2",
      "field": "terms[2](ゼロデイ攻撃).points[1].text_jp",
      "before": "「ゼロデイ」は、攻撃を始めてからの時間や、ウイルスの潜伏期間の長さを指す言葉ではない。修正前の脆弱性を突くという手口を表している。",
      "after": "「ゼロデイ」かどうかは、修正プログラムが出る前か後かで決まり、突かれる脆弱性や使われるプログラムの種類は問わない。",
      "reason": "Rule A M1"
    },
    {
      "id": "p02",
      "status": "active",
      "base_sha256": "95a33041b002fe6f2a3e7667e87d077c1955bc6cd550b6ce263536b27fcc2ec2",
      "field": "terms[2](ゼロデイ攻撃).points[1].text_zh",
      "before": "“零日”（[[jp:ゼロデイ]]）指的不是发起攻击后经过的时间，也不是病毒潜伏期的长短，而是专攻尚未修复的漏洞这一手法。",
      "after": "是否算“零日”（[[jp:ゼロデイ]]），取决于是在修复程序发布之前还是之后，与被利用的漏洞或所用程序的种类无关。",
      "reason": "Rule A M1"
    },
    {
      "id": "p03",
      "status": "active",
      "base_sha256": "95a33041b002fe6f2a3e7667e87d077c1955bc6cd550b6ce263536b27fcc2ec2",
      "field": "terms[2](ゼロデイ攻撃).points[1].text_en",
      "before": "\"Zero-day\" ([[jp:ゼロデイ]]) does not refer to the time since an attack began or to how long a virus lies dormant. It names the method of striking a vulnerability that has not yet been fixed.",
      "after": "Whether an attack counts as \"zero-day\" ([[jp:ゼロデイ]]) depends on whether it comes before or after the fix is released, not on the kind of vulnerability or program involved.",
      "reason": "Rule A M1"
    },
    {
      "id": "p04",
      "status": "active",
      "base_sha256": "95a33041b002fe6f2a3e7667e87d077c1955bc6cd550b6ce263536b27fcc2ec2",
      "field": "terms[0](DoS攻撃).points[0].text_jp",
      "before": "のねらいはサービスの妨害であり、管理者権限の奪取や情報の盗み出しではない。",
      "after": "のねらいはサービスの妨害で、損なわれるのは情報セキュリティの可用性である。",
      "reason": "Rule A M2"
    },
    {
      "id": "p05",
      "status": "active",
